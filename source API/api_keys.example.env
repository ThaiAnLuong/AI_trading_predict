# API keys. Copy this file to "api_keys.env" in this same folder and fill in only what you want.
# api_keys.env stays on your computer and is excluded from git. Never put a key in the code.
# Real environment variables take priority over this file.

# Market data: choose the provider in the Settings tab.
# The default, Yahoo (unofficial), needs no key.
# Alpha Vantage is the backup: free, Canadian tickers, closing prices only.
ALPHAVANTAGE_API_KEY=
# Twelve Data needs its paid Cboe Canada add-on for Canadian tickers.
TWELVEDATA_API_KEY=

# Optional company news.
FINNHUB_API_KEY=

# Optional LLM review of AI buy candidates.
# Also needs: pip install -r requirements-optional.txt
ANTHROPIC_API_KEY=
